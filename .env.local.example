# Copy this file to `.env.local` and fill in the values from your Supabase
# project settings (Project Settings > API).

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase project's public "anon" key (safe to expose in the browser,
# it is restricted by the Row Level Security policies in supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "Nous contacter" e-mail (Resend). Without RESEND_API_KEY the message is only
# stored as a ticket in the backoffice, no e-mail leaves the app.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=MAO <no-reply@your-verified-domain.com>
CONTACT_TO_EMAIL=contact@mao.com
